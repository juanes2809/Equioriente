# ── Supabase ───────────────────────────────────────────
# Obtén estos valores en: Supabase → Settings → API
# SUPABASE_URL: Project URL (https://xxxx.supabase.co)
# SUPABASE_KEY: service_role key (NO la anon key — necesita acceso total)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=eyJ...tu_service_role_key...

# ── Seguridad ─────────────────────────────────────────
# Cambia este valor por una cadena aleatoria larga en producción
JWT_SECRET=equioriente_secret_key_change_in_production

# ── Puerto ────────────────────────────────────────────
PORT=3000
