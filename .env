# ── Supabase (PostgreSQL) ─────────────────────────────
# Cuando DATABASE_URL está definido, el servidor usa Supabase en lugar de SQLite.
# Copia la connection string desde: Supabase → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Seguridad ─────────────────────────────────────────
# Cambia este valor por una cadena aleatoria en produccion
JWT_SECRET=equioriente_secret_key_change_in_production

# ── Puerto ────────────────────────────────────────────
PORT=3000
